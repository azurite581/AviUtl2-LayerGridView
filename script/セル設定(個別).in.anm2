--require:2005000
--information:${INFO} ${VERSION} by ${AUTHOR}
--label:${LABEL}
---$value:セル番号
local item_index = {}

--group:セル設定,false
---$check:セル設定を上書き
local override_cell_settings = false

---$check:セル色を上書き
local override_cell_col = false

---$color:セル色
local cell_col = 0x000000

--hide@cell_col:override_cell_col==0

---$track:セル透明度
---min=0
---max=100
---step=0.01
local cell_transparent = 0

---$select:角丸の単位
---px=0
---%=1
local item_round_unit = 0

---$track:角丸
---min=0
---max=4000
---step=0.01
local item_round = 0

---$select:枠幅の単位
---px=0
---%=1
local item_border_unit = 0

---$track:枠幅
---min=0
---max=4000
---step=0.01
local item_border = 0

---$color:枠色
local item_border_col = 0xffffff

---$track:枠透明度
---min=0
---max=100
---step=0.01
local item_border_transparent = 0

--group
--group:セル内オブジェクトの設定,false
---$check:セル内オブジェクトの設定を上書き
local override_item_settings = false

---$select:スケールモード
---内接最大=0
---外接最小=1
---引き伸ばす=2
local item_scale_mode = 0

---$track:X
---min=-4000
---max=4000
---step=0.01
local item_x = 0

---$track:Y
---min=-4000
---max=4000
---step=0.01
local item_y = 0

--trackgroup@item_x,item_y:Group
---$track:拡大率
---min=0
---max=1000
---step=0.001
local item_scale = 100

---$track:回転
---min=-360
---max=360
---step=0.01
local item_angle = 0

---$track:透明度
---min=0
---max=100
---step=0.01
local item_transparent = 0

---$select:領域外
---透明=0
---指定色=1
---引き伸ばす=2
---ループ=3
---ミラー=4
local sampler_mode = 0

---$color:領域外の色
local item_bg_col = 0xffffff

--hide@item_bg_col:sampler_mode~=1

--group
--group:ラベル設定,false
---$check:ラベル設定を上書き
local override_label_settings = false

---$track:X(%)
---min=-100
---max=100
---step=0.01
local label_x = 0

---$track:Y(%)
---min=-100
---max=100
---step=0.01
local label_y = 0

--trackgroup@label_x,label_y:label_pos
---$track:サイズ
---min=0
---max=1000
---step=1
local label_size = 40

---$font:フォント
local label_font = "Yu Gothic UI"

---$color:文字色
local label_text_col = 0xffffff

---$color:影・縁色
local label_outer_col = 0x000000

---$select:文字装飾
---標準文字=0
---影付き文字=1
---影付き文字​（薄）=2
---縁取り文字=3
---縁取り文字​（細）=4
---縁取り文字​（太）=5
---縁取り文字​（角）=6
local label_text_deco = 0

---$check:ラベル表示
local show_label = true
--group
