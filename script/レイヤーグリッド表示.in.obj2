--require:2005000
--information:${INFO} ${VERSION} by ${AUTHOR}
--group:グリッド設定,true
---$track:幅
---min=0
---max=8000
---step=1
local w = 1280

---$track:高さ
---min=0
---max=8000
---step=1
local h = 720

---$checksection:スクリーンサイズに合わせる
---multi_section=false
local screen_size = false

---$track:X個数
---min=1
---max=20
---step=1
local nx = 3

---$track:Y個数
---min=1
---max=20
---step=1
local ny = 3

---$checksection:結合
---multi_section=false
local is_merge_enabled = false

---$value:結合リスト
local merge = {{1,1}}

--hide@merge:is_merge_enabled==0

--group
--group:グリッドオフセットの設定,false
---$value:列オフセット
local col_ratio = {[1]=0}

---$value:行オフセット
local row_ratio = {[1]=0}

--group
--group:余白設定,false
---$track:余白X(%)
---min=0
---max=100
---step=1
local gap_w = 0

---$track:余白Y(%)
---min=0
---max=100
---step=1
local gap_h = 0

---$select:外側余白
---通常=0
---内側の幅と合わせる=1
---なし=2
local outer_margin_type = 0

--group:セル設定,false
---$check:セル色を上書き
local override_cell_col = false

---$color:セル色
local cell_col = 0x000000

--hide@cell_col:override_cell_col==0

---$track:セル透明度
---min=0
---max=100
---step=0.01
local cell_transparent = 0

---$select:角丸の単位
---px=0
---%=1
local item_round_unit = 0

---$track:角丸
---min=0
---max=4000
---step=0.01
local item_round = 0

---$select:枠幅の単位
---px=0
---%=1
local item_border_unit = 0

---$track:枠幅
---min=0
---max=4000
---step=0.01
local item_border = 0

---$color:枠色
local item_border_col = 0xffffff

---$track:枠透明度
---min=0
---max=100
---step=0.01
local item_border_transparent = 0

--group
--group:セル内オブジェクトの設定,false
---$select:スケールモード
---内接最大=0
---外接最小=1
---引き伸ばす=2
local item_scale_mode = 0

---$track:X
---min=-4000
---max=4000
---step=0.01
local item_x = 0

---$track:Y
---min=-4000
---max=4000
---step=0.01
local item_y = 0

--trackgroup@item_x,item_y:item_pos
---$track:拡大率
---min=0
---max=1000
---step=0.001
local item_scale = 100

---$track:回転
---min=-360
---max=360
---step=0.01
local item_angle = 0

---$track:透明度
---min=0
---max=100
---step=0.01
local item_transparent = 0

---$select:領域外
---透明=0
---指定色=1
---引き伸ばす=2
---ループ=3
---ミラー=4
local sampler_mode = 0

---$color:領域外の色
local bg_col = 0xffffff

--hide@bg_col:sampler_mode~=1

--group
--group:ラベル設定,false
---$track:X(%)
---min=-100
---max=100
---step=0.01
local label_x = 0

---$track:Y(%)
---min=-100
---max=100
---step=0.01
local label_y = 0

--trackgroup@label_x,label_y:label_pos
---$track:サイズ
---min=0
---max=1000
---step=1
local label_size = 40

---$font:フォント
local label_font = "Yu Gothic UI"

---$color:文字色
local label_text_col = 0xffffff

---$color:影・縁色
local label_outer_col = 0x000000

---$select:文字装飾
---標準文字=0
---影付き文字=1
---影付き文字​（薄）=2
---縁取り文字=3
---縁取り文字​（細）=4
---縁取り文字​（太）=5
---縁取り文字​（角）=6
local label_text_deco = 0

---$check:ラベル表示
local show_label = true

---$check:ラベル出力時非表示::出力時非表示
local label_hidden_output = true

--group
--group:レイヤー設定,true
---$check:レイヤー上のオブジェクトを読み込む
local load_layer = true

---$check:セル番号を対象レイヤーにする
local cell_layer = false

---$value:レイヤー
local layer = {[1]=1}

--group
--group:その他,false
---$check:セルサイズをログに出力する
local cell_size_log_enable = false

--group

--[[pixelshader@sample_texture:
---$include "sample_texture.hlsl"
]]

--[[pixelshader@round_border:
---$include "round_border.hlsl"
]]

--[[pixelshader@alpha:
Texture2D<float4> src : register(t0);
SamplerState samp : register(s0);
cbuffer constant0 : register(b0) {
    float a;
}
float4 alpha(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float4 tex = src.Sample(samp, uv);
    tex.a *= a;
    return tex;
}
]]

if w * h <= 0 then return end

local function linear(a, b, x) return a * (1 - x) + b * x end

local function clamp(x, min, max)
    if x < min then return min end
    if x > max then return max end
    return x
end

local function rotate(deg)
    local rad = math.rad(deg)
    return math.cos(rad), -math.sin(rad),
           math.sin(rad),  math.cos(rad)
end

local function hsv2rgb(h, s, v)
    return RGB(HSV(h * 360, s * 100, v * 100))
end

local function norm_rgb(col)
    local r, g, b = RGB(col)
    return r / 255, g / 255, b / 255
end

local function calc_max_font_size(text, name, type, target_size)
    obj.setfont(name, 1, type)
    local text_w, text_h = obj.load("text.layout", text)
    if math.max(text_w, text_h) > target_size then
        return 1
    end

    local lo, hi = 1, 1
    while true do
        hi = hi * 2
        obj.setfont(name, hi, type)
        text_w, text_h = obj.load("text.layout", text)
        if math.max(text_w, text_h) > target_size then
            break
        end
        lo = hi
    end

    while hi - lo > 1 do
        local mid = math.floor((lo + hi) / 2)
        obj.setfont(name, mid, type)
        text_w, text_h = obj.load("text.layout", text)
        if math.max(text_w, text_h) > target_size then
            hi = mid
        else
            lo = mid
        end
    end

    return hi
end

local function idx_to_xy(idx)
    local i = idx - 1
    return i % nx, math.floor(i / nx)
end

local function xy_to_idx(x, y)
    return y * nx + x + 1
end

local function parse_table(input)
    local result = {}
    for item in string.gmatch(input .. ",", "%s*(.-)%s*,") do
        table.insert(result, tonumber(item) or item)
    end
    return result
end

local function parse_check(input)
    return tonumber(input) ~= 0
end

local function parse_color(input)
    return tonumber(input, 16)
end

local function parse_list(dict, input)
    if dict[input] ~= nil then
        return dict[input]
    end
    return 0
end

local cell_limit = 400
local sat = 0.45
local val = 0.95
local sampler = {"clip", "clamp", "loop", "mirror", "dot"}
local effect_count_limit = 1000
local effect1_name = "セル設定(個別)@レイヤーグリッド表示"
local effect2_name = "グリッドオフセット設定(個別)@レイヤーグリッド表示"
local PAD = 0

local scale_mode_list = {
    ["内接最大"] = 0,
    ["外接最小"] = 1,
    ["引き伸ばす"] = 2
}
local sampler_mode_list = {
    ["透明"] = 0,
    ["指定色"] = 1,
    ["引き伸ばす"] = 2,
    ["ループ"] = 3,
    ["ミラー"] = 4
}
local unit_list = {
    ["px"] = 0,
    ["%"] = 1
}
local text_deco_list = {
    ["標準文字"] = 0,
    ["影付き文字"] = 1,
    ["影付き文字​（薄）"] = 2,
    ["縁取り文字"] = 3,
    ["縁取り文字​（細）"] = 4,
    ["縁取り文字​（太）"] = 5,
    ["縁取り文字​（角）"] = 6
}

local effect1_count = 0
local effect2_count = 0
for i = 1, effect_count_limit, 1 do
    if obj.getoption("script_name", i, true) == effect1_name then
        effect1_count = effect1_count + 1
    end
    if obj.getoption("script_name", i, true) == effect2_name then
        effect2_count = effect2_count + 1
    end
end

local item_tables = {}
for index = 0, effect1_count - 1, 1 do
    local effect_name = effect1_name..":"..index
    local index_table = parse_table(obj.getvalue(effect_name, "セル番号")) or {}
    for _, index in ipairs(index_table) do
        item_tables[index] = {
            -- セル
            override_cell_settings  = parse_check(obj.getvalue(effect_name, "セル設定を上書き")) or false,
            override_cell_col       = parse_check(obj.getvalue(effect_name, "セル色を上書き")) or false,
            cell_col                 = parse_color(obj.getvalue(effect_name, "セル色")),
            cell_transparent         = obj.getvalue(effect_name, "セル透明度"),
            round_unit               = parse_list(unit_list, obj.getvalue(effect_name, "角丸の単位")) or 0,
            round                    = obj.getvalue(effect_name, "角丸") or 0,
            border_unit              = parse_list(unit_list, obj.getvalue(effect_name, "枠幅の単位")) or 0,
            border                   = obj.getvalue(effect_name, "枠幅") or 0,
            border_col               = parse_color(obj.getvalue(effect_name, "枠色")) or 0,
            border_transparent       = obj.getvalue(effect_name, "枠透明度") or 0,
            -- セル内オブジェクト
            override_item_settings  = parse_check(obj.getvalue(effect_name, "セル内オブジェクトの設定を上書き")) or false,
            scale_type               = parse_list(scale_mode_list, obj.getvalue(effect_name, "スケールモード")) or 0,
            x                        = obj.getvalue(effect_name, "X") or 0,
            y                        = obj.getvalue(effect_name, "Y") or 0,
            scale                    = obj.getvalue(effect_name, "拡大率") or 0,
            sampler_mode             = parse_list(sampler_mode_list, obj.getvalue(effect_name, "領域外")) or 0,
            bg_col                   = parse_color(obj.getvalue(effect_name, "領域外の色")) or 0,
            angle                    = obj.getvalue(effect_name, "回転") or 0,
            transparent              = obj.getvalue(effect_name, "透明度") or 0,
            -- ラベル
            override_label_settings = parse_check(obj.getvalue(effect_name, "ラベル設定を上書き")) or false,
            label_x                  = obj.getvalue(effect_name, "X(%)") or 0,
            label_y                  = obj.getvalue(effect_name, "Y(%)") or 0,
            label_size               = obj.getvalue(effect_name, "サイズ") or 0,
            label_font               = obj.getvalue(effect_name, "フォント") or "Yu Gothic UI",
            label_text_col           = parse_color(obj.getvalue(effect_name, "文字色")) or 0,
            label_outer_col          = parse_color(obj.getvalue(effect_name, "影・縁色")) or 0,
            label_text_deco          = parse_list(text_deco_list, obj.getvalue(effect_name, "文字装飾")) or 0,
            show_label               = parse_check(obj.getvalue(effect_name, "ラベル表示")) or false,
        }
    end
end

for index = 0, effect2_count - 1, 1 do
    local effect_name = effect2_name..":"..index

    local target_col_index = parse_table(obj.getvalue(effect_name, "対象列番号"))
    local col_offset = obj.getvalue(effect_name, "列オフセット") or 0
    for _, index in ipairs(target_col_index) do
        col_ratio[index] = col_offset
    end

    local target_row_index = parse_table(obj.getvalue(effect_name, "対象行番号"))
    local row_offset = obj.getvalue(effect_name, "行オフセット") or 0
    for _, index in ipairs(target_row_index) do
        row_ratio[index] = row_offset
    end
end

local cell_num = nx * ny
if screen_size then
    w = obj.screen_w
    h = obj.screen_h
end
local cw = w / nx
local ch = h / ny
gap_w = (100 - gap_w) / 100
gap_h = (100 - gap_h) / 100
local cell_r, cell_g, cell_b = RGB(cell_col)
item_x = item_x / 100
item_y = item_y / 100
item_scale = item_scale / 100
local m00, m01, m10, m11 = rotate(item_angle)
item_transparent = (100 - item_transparent) / 100
local bg_col_r, bg_col_g, bg_col_b = norm_rgb(bg_col)
local bg_col_a = 1
if item_round_unit == 1 then item_round = math.min(item_round, 100) / 100 end
if item_border_unit == 1 then item_border = item_border / 100 end
local border_col_r, border_col_g, border_col_b = norm_rgb(item_border_col)
item_border_transparent = (100 - item_border_transparent) / 100
if cell_layer then
    for i = 1, cell_limit, 1 do
        layer[i] = i
    end
end

local merge_owner = {}
local merge_span = {}
for i = 1, cell_num do
    merge_owner[i] = i
end

if is_merge_enabled then
    local claimed_by = {}
    for merge_index, pair in ipairs(merge) do
        local tx, ty = pair[1], pair[2]
        if tx and ty and tx >= 1 and tx <= cell_num and ty >= 1 and ty <= cell_num then
            local ax, ay = idx_to_xy(tx)
            local bx, by = idx_to_xy(ty)
            local px0, px1 = math.min(ax, bx), math.max(ax, bx)
            local py0, py1 = math.min(ay, by), math.max(ay, by)
            local owner_index = math.min(tx, ty)

            -- この矩形が既存の結合済みセルと重なっていないか確認
            local conflict = false
            for py = py0, py1 do
                for px = px0, px1 do
                    if claimed_by[xy_to_idx(px, py)] ~= nil then
                        conflict = true
                        break
                    end
                end
                if conflict then break end
            end

            if conflict then
                print("@warn", string.format("結合{%d, %d}は既存の結合と重複するためスキップされました", tx, ty))
            else
                merge_span[owner_index] = { px0, py0, px1, py1 }
                for py = py0, py1 do
                    for px = px0, px1 do
                        local idx = xy_to_idx(px, py)
                        claimed_by[idx] = merge_index
                        merge_owner[idx] = owner_index
                    end
                end
            end
        end
    end
end

for key, value in pairs(col_ratio) do
    col_ratio[key] = clamp(value, -100, 100)
end

for key, value in pairs(row_ratio) do
    row_ratio[key] = clamp(value, -100, 100)
end

local col_bound = {}
col_bound[0] = -w / 2
for i = 1, nx - 1 do
    local default_pos = i * cw - w / 2
    local offset = (col_ratio[i] or 0) / 100
    local pos = default_pos + offset * cw
    col_bound[i] = math.floor(pos + 0.5)
end
col_bound[nx] = w / 2

-- セル幅が負にならないようにする
for i = 1, nx - 1 do
    col_bound[i] = math.max(col_bound[i], col_bound[i - 1])
end
for i = nx - 1, 1, -1 do
    col_bound[i] = math.min(col_bound[i], col_bound[i + 1])
end

local col_x0, col_x1 = {}, {}
for x = 0, nx - 1 do
    local px0 = col_bound[x]
    local px1 = col_bound[x + 1]

    local base_px0 = x * cw - w / 2
    local base_px1 = (x + 1) * cw - w / 2
    local base_center = linear(base_px0, base_px1, 0.5)
    if outer_margin_type == 1 then
        base_center = linear(base_px0, base_px1, 1 / (nx + 1) * (nx - x))
    elseif outer_margin_type == 2 then
        base_center = (nx > 1) and linear(base_px0, base_px1, 1 / (nx - 1) * x) or linear(base_px0, base_px1, 0.5)
    end
    local margin_left  = (1 - gap_w) * (base_center - base_px0)
    local margin_right = (1 - gap_w) * (base_px1 - base_center)

    col_x0[x] = px0 + margin_left
    col_x1[x] = px1 - margin_right

    if col_x1[x] < col_x0[x] then
        local mid = (col_x0[x] + col_x1[x]) / 2
        col_x0[x] = mid
        col_x1[x] = mid
    end
end

local row_bound = {}
row_bound[0] = -h / 2
for y = 1, ny - 1 do
    local default_pos = y * ch - h / 2
    local offset = (row_ratio[y] or 0) / 100
    local pos = default_pos + offset * ch
    row_bound[y] = math.floor(pos + 0.5)
end
row_bound[ny] = h / 2

for y = 1, ny - 1 do
    row_bound[y] = math.max(row_bound[y], row_bound[y - 1])
end
for y = ny - 1, 1, -1 do
    row_bound[y] = math.min(row_bound[y], row_bound[y + 1])
end

local row_y0, row_y1 = {}, {}
for y = 0, ny - 1 do
    local py0 = row_bound[y]
    local py1 = row_bound[y + 1]

    local base_py0 = y * ch - h / 2
    local base_py1 = (y + 1) * ch - h / 2
    local base_center = linear(base_py0, base_py1, 0.5)
    if outer_margin_type == 1 then
        base_center = linear(base_py0, base_py1, 1 / (ny + 1) * (ny - y))
    elseif outer_margin_type == 2 then
        base_center = (ny > 1) and linear(base_py0, base_py1, 1 / (ny - 1) * y) or linear(base_py0, base_py1, 0.5)
    end
    local margin_top    = (1 - gap_h) * (base_center - base_py0)
    local margin_bottom = (1 - gap_h) * (base_py1 - base_center)

    row_y0[y] = py0 + margin_top
    row_y1[y] = py1 - margin_bottom

    if row_y1[y] < row_y0[y] then
        local mid = (row_y0[y] + row_y1[y]) / 2
        row_y0[y] = mid
        row_y1[y] = mid
    end
end

local cell_owner = {}
local cell_size = {}
local item_center = {}
local cell_color = {}
for y = 0, ny - 1 do
    for x = 0, nx - 1 do
        local idx = xy_to_idx(x, y)
        idx = merge_owner[idx]

        local gx0, gy0, gx1, gy1 = x, y, x, y
        local span = merge_span[idx]
        if span then
            gx0, gy0, gx1, gy1 = span[1], span[2], span[3], span[4]
        end

        local px0, px1 = col_x0[gx0] or -w / 2, col_x1[gx1] or w / 2
        local py0, py1 = row_y0[gy0] or -h / 2, row_y1[gy1] or h / 2

        table.insert(cell_size, { px1 - px0, py1 - py0 })
        table.insert(item_center, { linear(px0, px1, 0.5), linear(py0, py1, 0.5) })

        local diag_count = nx + ny - 1
        local diag = (x - y) + (ny - 1)
        local hue = diag / diag_count
        local r, g, b = hsv2rgb(hue, sat, val)

        if override_cell_col then
            r = cell_r; g = cell_g; b = cell_b;
        end
        table.insert(cell_color, RGB(r, g, b))
        table.insert(cell_owner, idx)
    end
end

local draw = {}
local obj_layer = obj.layer
obj.multiobject(cell_num, function()
    local index = obj.index + 1
    local cell_index = cell_owner[index]

    if cell_index == nil then return end
    if draw[cell_index] == nil then
        draw[cell_index] = true
        local cell_w, cell_h = cell_size[index][1], cell_size[index][2]
        local cell_x, cell_y = item_center[index][1], item_center[index][2]

        if cell_size_log_enable then
            print(string.format(
                "[セル%d] サイズ: %dx%dpx, 割合: %.1f%%:%.1f%%",
                cell_index,
                cell_w, cell_h,
                cell_w / w * 100,
                cell_h / h * 100)
            )
        end

        -- セルの設定
        local t_cell_color = cell_color[index]
        local t_cell_transparent = (100 - cell_transparent) / 100
        local t_border_unit = item_border_unit
        local t_border = item_border
        local t_border_r, t_border_g, t_border_b = border_col_r, border_col_g, border_col_b
        local t_border_transparent = item_border_transparent
        local t_round_unit = item_round_unit
        local t_round = item_round

        -- セル内オブジェクトの設定
        local t_item_scale_mode = item_scale_mode
        local t_item_x = item_x
        local t_item_y = item_y
        local t_item_scale = item_scale
        local t_sampler_mode = sampler_mode
        local t_bg_col_r, t_bg_col_g, t_bg_col_b = bg_col_r, bg_col_g, bg_col_b
        local t_m00, t_m01, t_m10, t_m11 = m00, m01, m10, m11
        local t_item_transparent = item_transparent

        -- ラベルの設定
        local t_label_x = label_x
        local t_label_y = label_y
        local t_label_font = label_font
        local t_label_text_deco = label_text_deco
        local t_label_size = label_size
        local t_label_text_col = label_text_col
        local t_label_outer_col = label_outer_col
        local t_show_label = show_label

        -- 各設定を上書き
        if item_tables[index] ~= nil then
            local item = item_tables[index]

            -- セルの設定
            if item.override_cell_settings then
                if item.override_cell_col then
                    t_cell_color = item.cell_col
                end
                t_cell_transparent = (100 - item.cell_transparent) / 100
                t_border_unit = item.border_unit
                if t_border_unit == 1 then
                    t_border = item.border / 100
                else
                    t_border = item.border
                end
                t_border_r, t_border_g, t_border_b = norm_rgb(item.border_col)
                t_border_transparent = (100 - item.border_transparent) / 100
                t_round_unit = item.round_unit
                if t_round_unit == 1 then
                    t_round = math.min(item.round, 100) / 100
                else
                    t_round = item.round
                end
            end

            -- セル内オブジェクトの設定
            if item.override_item_settings then
                t_item_scale_mode = item.scale_type
                t_item_x = item.x / 100
                t_item_y = item.y / 100
                t_item_scale = item.scale / 100
                t_sampler_mode = item.sampler_mode
                t_bg_col_r, t_bg_col_g, t_bg_col_b = norm_rgb(item.bg_col)
                t_m00, t_m01, t_m10, t_m11 = rotate(item.angle)
                t_item_transparent = (100 - item.transparent) / 100
            end

            -- ラベルの設定
            if item.override_label_settings then
                t_label_x = item.label_x
                t_label_y = item.label_y
                t_label_font = item.label_font
                t_label_text_deco = item.label_text_deco
                t_label_size = item.label_size
                t_label_text_col = item.label_text_col
                t_label_outer_col = item.label_outer_col
                t_show_label = item.show_label
            end
        end

        if math.floor(cell_w + 0.5) * math.floor(cell_h + 0.5) > 0 then
            local layer_index = layer[cell_index]
            -- レイヤー上のオブジェクトを読み込む
            if load_layer and layer_index ~= nil and obj_layer ~= layer_index then
                local loaded = obj.load("layer", layer_index, true)

                if loaded and obj.w * obj.h > 0 then
                    local s = {cell_w / obj.w, cell_h / obj.h};
                    local scale = 1
                    if t_item_scale_mode == 0 then
                        scale = math.min(s[1], s[2])
                    elseif t_item_scale_mode == 1 then
                        scale = math.max(s[1], s[2])
                    end

                    local samp = sampler[1]
                    if t_sampler_mode == 0 or t_sampler_mode == 1 then
                        samp = "clip"
                    else
                        samp = sampler[t_sampler_mode]
                    end
                    if t_sampler_mode ~= 1 then
                        t_bg_col_r, t_bg_col_g, t_bg_col_b = norm_rgb(t_cell_color)
                    end

                    obj.clearbuffer("tempbuffer", cell_w, cell_h)
                    obj.pixelshader("sample_texture", "tempbuffer", {"object"}, {
                        cell_w, cell_h, obj.w, obj.h,
                        t_item_scale_mode, scale, t_sampler_mode, PAD,
                        t_item_scale, t_item_transparent, t_item_x, t_item_y,
                        t_bg_col_r, t_bg_col_g, t_bg_col_b, bg_col_a,
                        t_m00, t_m01, PAD, PAD,
                        t_m10, t_m11, PAD, PAD,
                    }, "copy", samp)
                else
                    obj.clearbuffer("tempbuffer", cell_w, cell_h, t_cell_color)
                    obj.pixelshader("alpha", "tempbuffer", {"tempbuffer"}, {t_cell_transparent})

                    local load_failed_msg = "レイヤー"..tostring(layer_index).."のオブジェクトを読み込めませんでした"
                    print("@warn", load_failed_msg)
                end
            else
                obj.clearbuffer("tempbuffer", cell_w, cell_h, t_cell_color)
                obj.pixelshader("alpha", "tempbuffer", {"tempbuffer"}, {t_cell_transparent})
            end

            -- 角丸と枠の描画
            obj.pixelshader("round_border", "tempbuffer", {"tempbuffer"}, {
                cell_w, cell_h, t_round_unit, t_round,
                t_border_unit, t_border, PAD, PAD,
                t_border_r, t_border_g, t_border_b, t_border_transparent
            }, "copy", "clip")

            -- ラベルの描画
            if not label_hidden_output or obj.getinfo("saving") ~= true then
                if t_show_label then
                    local label_text = tostring(cell_index)
                    local t_label_cx = (t_label_x + 100) / 2 / 100
                    local t_label_cy = (t_label_y + 100) / 2 / 100

                    local px0, py0, px1, py1 = -cell_w / 2, -cell_h / 2, cell_w / 2, cell_h / 2
                    local anchor_x = linear(px0, px1, t_label_cx)
                    local anchor_y = linear(py0, py1, t_label_cy)

                    local max_font_size = calc_max_font_size("000", t_label_font, t_label_text_deco, math.min(cell_w, cell_h))
                    t_label_size = math.min(t_label_size, max_font_size)

                    obj.setfont(t_label_font, t_label_size, t_label_text_deco, t_label_text_col, t_label_outer_col)
                    local text_w, text_h = obj.load("text.layout", label_text)
                    obj.load("text", label_text)

                    local lx = anchor_x - (t_label_x / 100) * text_w / 2
                    local ly = anchor_y - (t_label_y / 100) * text_h / 2
                    obj.setoption("drawtarget", "tempbuffer")
                    obj.draw(lx, ly)
                end
            end
        else
            obj.clearbuffer("tempbuffer")
        end

        obj.copybuffer("object", "tempbuffer")
        obj.clearbuffer("tempbuffer")

        obj.ox = cell_x
        obj.oy = cell_y
    else
        obj.clearbuffer("object")
    end
end)
